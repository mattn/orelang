is(3, to_int(3.7), "to_int float");
is(42, to_int("42"), "to_int string");
is(255, to_int("0xff"), "to_int hex string");
is(1, to_int(true), "to_int bool");
is(2.5, to_float("2.5"), "to_float string");
is(2.0, to_float(2), "to_float int");

is(5, abs(-5), "abs int");
is(1.5, abs(-1.5), "abs float");
is(5, abs(5), "abs positive");

is(1, floor(1.9), "floor");
is(-2, floor(-1.1), "floor negative");
is(2, ceil(1.1), "ceil");
is(2, round(1.5), "round up");
is(1, round(1.4), "round down");

is(3.0, sqrt(9), "sqrt");
is(8.0, pow(2, 3), "pow");

# vim: set ft=ore:

is(2147483648, 2147483647 + 1, "no 32-bit overflow");
is(1099511627776, 2 ** 40, "2 ** 40");
is(9999999999, to_int("9999999999"), "to_int 64bit");
is("1099511627776", format("%d", 1099511627776), "format 64bit");
