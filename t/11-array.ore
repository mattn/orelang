a = [1, 2];
push(a, 3);
is(3, len(a), "push len");
is(3, a[2], "push value");
push(a, 4, 5);
is(5, len(a), "push multi");

v = pop(a);
is(5, v, "pop value");
is(4, len(a), "pop len");

e = [];
is(nil, pop(e), "pop empty");
push(e, 9);
is(9, e[0], "push after pop empty");

s = slice([10, 20, 30, 40], 1, 3);
is(2, len(s), "slice len");
is(20, s[0], "slice first");
is(30, s[1], "slice last");

r = sort([3, 1, 2]);
is(1, r[0], "sort int 0");
is(2, r[1], "sort int 1");
is(3, r[2], "sort int 2");

t = sort(["b", "a", "c"]);
is("a", t[0], "sort str 0");
is("c", t[2], "sort str 2");

f = sort([2.5, 1, 2]);
is(1, f[0], "sort mixed numeric");

# vim: set ft=ore:
