ok(1 > 0, "1 > 0");
ok(1.5 > 1.4, "1.5 > 1.4");
ok(1.4 < 1.5, "1.4 < 1.5");
ok(1 < 1.5, "1 < 1.5");
ok(1.5 > 1, "1.5 > 1");
ok(1 == 1.0, "1 == 1.0");
ok(1 != "1", "1 != \"1\"");
ok(1 == 1, "1 == 1");
ok(1.1 == 1.1, "1.1 == 1.1");
ok("1" == "1", "\"1\" == \"1\"");

ok(false != "1", "false != \"1\"");
ok(false != true, "false != true");
ok(false == false, "false == false");
ok(true == true, "true == true");
ok(false == false, "false == false");
ok(nil == nil, "nil == nil");

ok(1 <= 1, "1 <= 1");
ok(1.0 <= 1.0, "1.0 <= 1.0");
ok(1 >= 1, "1 >= 1");
ok(2 >= 1, "2 >= 1");
ok(1.0 >= 1.0, "1.0 >= 1.0");

ok(true && true, "true && true");
ok(!(true && false), "!(true && false)");
ok(true || false, "true || false");
ok(!false, "!false");
ok(!0, "!0");
ok(1 < 2 && 2 < 3, "1 < 2 && 2 < 3");
ok(1 > 2 || 5 == 5, "1 > 2 || 5 == 5");
ok(false && boom() || true, "short circuit &&");

x = 5;
is(-5, -x, "unary minus");
y = 1.5;
is(-1.5, -y, "unary minus float");

a = 7; a %= 3;
is(1, a, "%=");

h = {"a": 1};
ok(h["a"] == 1, "h[\"a\"] == 1");
arr = [2,3];
ok(arr[0] * arr[1] == 6, "arr[0] * arr[1] == 6");
ok(arr[0] + 1 == 3, "arr[0] + 1 == 3");
ok(1 == 2 - 1, "1 == 2 - 1");
ok(1 + 2 * 3 == 7, "1 + 2 * 3 == 7");

is(true, 1 <= 2 ? true : false, "1 <= 2 ? true : false");
is("b", 1 > 2 ? "a" : "b", "ternary false branch");
is(2, false ? 1 : true ? 2 : 3, "nested ternary");
x = 10;
is("big", x > 5 ? "big" : "small", "ternary with var");

a = 1; a += 1;
is(2, a, "+=");

a = 2; a -= 1;
is(1, a, "-=");

a = 2; a *= 2;
is(4, a, "*=");

a = 3; a /= 2.0;
is(1.5, a, "/=");

is(7, 1 + 2 * 3, "1 + 2 * 3");
is(7, 2 * 3 + 1, "2 * 3 + 1");
is(8, 10 - 4 / 2, "10 - 4 / 2");
is(2, 1 + 10 % 3, "1 + 10 % 3");
is(4, 1 + 2 - 3 + 4, "1 + 2 - 3 + 4");

#a = 2; a++;
#is(3, a, "++");

#a = 2; a--;
#is(1, a, "--");

#a = 2**3;
#is(8, a, "**");

#a = 1; a &= 2;
#is(0, a, "&=");

#a = 1; a |= 2;
#is(3, a, "|=");

#a = !3;
#is(false, a, "!3");

#a = !true;
#is(false, a, "!true");

#a = !false;
#is(true, a, "!false");

#a = ^3;
#is(-4, a, "^3");

#a = 3 << 2;
#is(12, a, "3 << 2");

#a = 11 >> 2;
#is(2, a, "11 >> 2");

# vim: set ft=ore:

