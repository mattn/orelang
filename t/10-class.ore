class C {
  var x = 1;
}

o = new C();
is(1, o.x, "prop read");

o.x = 5;
is(5, o.x, "prop assign");

o.x += 1;
is(6, o.x, "prop compound assign");

o.y = 7;
is(7, o.y, "prop new field");

class P {
  var a = 0;
  func __initialize__(x, y) {
    this.a = x + y;
  }
  func get() {
    return this.a;
  }
}

p = new P(1, 2);
is(3, p.a, "initialize args");
is(3, p.get(), "method call");

# vim: set ft=ore:
