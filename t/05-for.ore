x = 0;
for (a in [1,2,3]) {
  x = x + 1;
}
is(3, x, "for a in range [1,2,3]");

x = 0;
while (1) {
  x = x + 1;
  if (x > 3) {
    break;
  }
}
is(4, x, "for loop");

func find3() {
  for (a in [1,2,3,4,5]) {
    if (a == 3) {
      return a;
    }
  }
  return -1;
}
is(3, find3(), "return from for");

func find4() {
  i = 0;
  while (true) {
    i = i + 1;
    if (i == 4) {
      return i;
    }
  }
  return -1;
}
is(4, find4(), "return from while");

x = 0;
for (a = 0; a < 10; a++) {
  x++;
}
is(10, x, "C-style for loop");

s = 0;
for (i = 0; i < 5; i = i + 1) {
  if (i == 2) {
    continue;
  }
  if (i == 4) {
    break;
  }
  s += i;
}
is(4, s, "for with break/continue");

func findc() {
  for (i = 0; ; i++) {
    if (i == 3) {
      return i;
    }
  }
  return -1;
}
is(3, findc(), "for empty cond and return");

# vim: set ft=ore:
